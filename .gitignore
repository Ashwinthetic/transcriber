# ==========================================
# Transcriber Project .gitignore
# ==========================================

# ------------------------------------------
# Python Environments & Bytecode
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
backend/.venv/

# Testing & Linting Caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key

# ------------------------------------------
# Data, Datasets & Vector Stores
# ------------------------------------------
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.csv
*.jsonl
*.parquet
*.tsv
*.tar.gz
*.zip
*.bin

# FAISS / Vector Index Files
*.index
*.faiss
vector_store/
faiss_index/

# ------------------------------------------
# Node / Frontend (React + Vite)
# ------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/dist/
frontend/build/

# ------------------------------------------
# Benchmarks & Logs
# ------------------------------------------
benchmarks/results/*
!benchmarks/results/.gitkeep
*.log

# ------------------------------------------
# IDE & Operating System Files
# ------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
