# ==========================================
# Transcriber Project .gitattributes
# ==========================================

# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Python & Web Source Files
*.py text eol=lf
*.tsx text eol=lf
*.ts text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary Files
*.faiss binary
*.index binary
*.bin binary
*.png binary
*.jpg binary
*.webp binary
*.zip binary
